{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sanfan-yoga-site.vercel.app"
        }
      ],
      "destination": "https://fjsanfan.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/de/index.html",
      "destination": "/de/",
      "permanent": true
    },
    {
      "source": "/ja/index.html",
      "destination": "/ja/",
      "permanent": true
    },
    {
      "source": "/ko/index.html",
      "destination": "/ko/",
      "permanent": true
    }
  ]
}
